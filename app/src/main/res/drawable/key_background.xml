<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_pressed" />
            <corners android:radius="@dimen/key_corner_radius" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_checked" />
            <corners android:radius="@dimen/key_corner_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/key_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background" />
            <corners android:radius="@dimen/key_corner_radius" />
        </shape>
    </item>
</selector>

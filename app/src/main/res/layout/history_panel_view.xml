<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/key_gutter"
            android:paddingTop="@dimen/history_header_spacing"
            android:paddingEnd="@dimen/key_gutter"
            android:paddingBottom="@dimen/history_header_spacing">

            <TextView
                android:id="@+id/history_title"
                style="@style/ScannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/history_title"
                android:textStyle="bold" />

            <org.ubaierbhat.android.barcodekeyboard.keyboard.KeyView
                android:id="@+id/history_clear_key"
                style="@style/KeyWordLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/key_height"
                android:layout_marginStart="@dimen/key_padding"
                android:layout_weight="1"
                android:contentDescription="@string/history_clear_description"
                android:text="@string/history_clear_label" />

            <org.ubaierbhat.android.barcodekeyboard.keyboard.KeyView
                android:id="@+id/history_close_key"
                style="@style/KeyWordLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/key_height"
                android:layout_marginStart="@dimen/key_padding"
                android:layout_weight="1"
                android:contentDescription="@string/history_close_description"
                android:text="@string/history_close_label" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/key_gutter"
                android:paddingEnd="@dimen/key_gutter"
                android:paddingBottom="@dimen/keyboard_bottom_padding"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/history_empty"
                style="@style/ScannerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/history_empty"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</merge>
